---
const { title, description, date, category, author, faqs, lang = 'fr' } = Astro.props;
const isEN = lang === 'en';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const logoUrl = "https://media.base44.com/images/public/69d90908f4f5dee0cdc0b7ac/7df7d4a03_Logoblanc.png";
const signupUrl = "https://app.grow-lot.com?utm_source=growlot-blog&utm_medium=blog&utm_campaign=cta";
const siteUrl = "https://grow-lot.com";
const blogUrl = "https://blog.grow-lot.com";
const isArticle = !!date;

const i18n = {
  blogLabel: isEN ? "Grow Lot Blog" : "Blog Grow Lot",
  blogLink: isEN ? "/en" : "/",
  ctaLabel: isEN ? "Try for free →" : "Essayer gratuitement →",
  footerTagline: isEN ? "The loyalty solution for local businesses." : "La solution de fidélisation pour les commerçants.",
  footerDisclaimer: isEN ? "Content written by the Grow Lot team. Some links may be affiliated." : "Contenu rédigé par l'équipe Grow Lot. Certains liens peuvent être affiliés.",
  ctaBoxTitle: isEN ? "Ready to grow customer loyalty?" : "Prêt à fidéliser vos clients avec Grow Lot ?",
  ctaBoxDesc: isEN ? "Lucky wheel, automated Google review collection, negative review filter — all in one, from €49/month." : "Roue de la fortune, collecte d'avis automatisée, filtre anti-avis négatifs — tout en un, à partir de 49€/mois.",
  ctaBoxBtn: isEN ? "Start for free →" : "Démarrer gratuitement →",
  faqTitle: isEN ? "Frequently Asked Questions" : "Questions fréquentes",
  altLangLabel: isEN ? "🇫🇷 Français" : "🇬🇧 English",
  altLangHref: isEN ? "/" : "/en",
  breadcrumbHome: isEN ? "Grow Lot Blog" : "Blog Grow Lot",
  by: isEN ? "By" : "Par",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": i18n.blogLabel,
  "url": isEN ? `${blogUrl}/en` : blogUrl,
  "description": isEN ? "Practical guides on customer loyalty and Google reviews for local businesses." : "Guides pratiques de fidélisation client et avis Google pour commerçants et restaurateurs en France.",
  "publisher": { "@type": "Organization", "name": "Grow Lot", "url": siteUrl, "logo": { "@type": "ImageObject", "url": logoUrl } },
  "inLanguage": isEN ? "en" : "fr-FR"
};

const articleSchema = isArticle ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date,
  "dateModified": date,
  "inLanguage": isEN ? "en" : "fr-FR",
  "url": canonicalURL.toString(),
  "author": { "@type": "Organization", "name": "Grow Lot", "url": siteUrl },
  "publisher": { "@type": "Organization", "name": "Grow Lot", "url": siteUrl, "logo": { "@type": "ImageObject", "url": logoUrl } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL.toString() }
} : null;

const faqSchema = (faqs && faqs.length > 0) ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: {q: string, a: string}) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
} : null;

const breadcrumbSchema = isArticle ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": i18n.breadcrumbHome, "item": isEN ? `${blogUrl}/en` : blogUrl },
    { "@type": "ListItem", "position": 2, "name": title, "item": canonicalURL.toString() }
  ]
} : null;
---
<!DOCTYPE html>
<html lang={isEN ? "en" : "fr"}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {i18n.blogLabel}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Grow Lot" />
  {isEN
    ? <link rel="alternate" hreflang="fr" href={canonicalURL.toString().replace('/en/blog/', '/blog/').replace('/en', '/')} />
    : <link rel="alternate" hreflang="en" href={`${blogUrl}/en${Astro.url.pathname}`} />
  }
  <link rel="alternate" hreflang="x-default" href={blogUrl} />
  <meta property="og:title" content={`${title} | Grow Lot`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={isEN ? "en_US" : "fr_FR"} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  {isArticle && articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  {isArticle && breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --violet: #654a98;
      --violet-dark: #4e3875;
      --violet-pale: #f0ebff;
      --yellow: #fdd643;
      --yellow-dark: #e8c200;
      --dark: #111827;
      --gray: #6b7280;
      --border: #e5e7eb;
      --white: #ffffff;
      --font-sans: 'Inter', system-ui, sans-serif;
      --font-display: 'Poppins', system-ui, sans-serif;
    }
    html { height: 100%; scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      font-size: 1rem;
      line-height: 1.75;
      color: var(--dark);
      background: #f9fafb;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--violet); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* HEADER */
    .site-header {
      background: var(--violet);
      padding: 0 5%;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0,0,0,.15);
    }
    .header-left { display: flex; align-items: center; gap: 1rem; }
    .logo img { height: 34px; width: auto; display: block; }
    .lang-pill {
      font-size: 0.72rem;
      font-weight: 600;
      color: rgba(255,255,255,.75);
      border: 1px solid rgba(255,255,255,.3);
      padding: 0.2rem 0.65rem;
      border-radius: 20px;
      transition: all .2s;
      font-family: var(--font-display);
    }
    .lang-pill:hover { color: white; border-color: white; background: rgba(255,255,255,.1); text-decoration: none; }
    .header-nav { display: flex; align-items: center; gap: 1rem; }
    .header-nav > a:not(.btn-cta) {
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(255,255,255,.8);
      font-family: var(--font-display);
    }
    .header-nav > a:not(.btn-cta):hover { color: white; text-decoration: none; }
    .btn-cta {
      background: var(--yellow);
      color: var(--dark) !important;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.82rem;
      padding: 0.5rem 1.15rem;
      border-radius: 6px;
      white-space: nowrap;
      transition: background .2s, transform .15s;
      text-decoration: none !important;
    }
    .btn-cta:hover { background: var(--yellow-dark); transform: translateY(-1px); }

    /* HERO */
    .hero {
      background: linear-gradient(140deg, var(--violet-dark) 0%, var(--violet) 60%, #8b6bb5 100%);
      padding: 4rem 5% 3.5rem;
      text-align: center;
    }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      font-weight: 800;
      color: white;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }
    .hero h1 em {
      font-style: normal;
      color: var(--yellow);
    }
    .hero p {
      color: rgba(255,255,255,.7);
      font-size: 1.05rem;
      max-width: 520px;
      margin: 0 auto;
    }

    /* PAGE WRAPPER */
    .page-body { flex: 1; display: flex; flex-direction: column; }

    /* HOMEPAGE GRID */
    .home-container {
      max-width: 900px;
      margin: 0 auto;
      width: 100%;
      padding: 3rem 5% 5rem;
    }
    .home-container h2 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--dark);
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid var(--border);
    }
    .articles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }
    .article-card {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-decoration: none !important;
      color: inherit;
      transition: border-color .2s, box-shadow .2s, transform .15s;
    }
    .article-card:hover {
      border-color: var(--violet);
      box-shadow: 0 8px 24px rgba(101,74,152,.12);
      transform: translateY(-2px);
    }
    .category-badge {
      display: inline-block;
      background: var(--violet-pale);
      color: var(--violet);
      font-family: var(--font-display);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      padding: 0.2rem 0.65rem;
      border-radius: 20px;
      width: fit-content;
    }
    .article-card h2 {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 700;
      color: var(--dark);
      line-height: 1.35;
      margin: 0;
    }
    .article-card .desc {
      font-size: 0.875rem;
      color: var(--gray);
      line-height: 1.6;
      flex: 1;
    }
    .article-card .read-more {
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--violet);
    }
    .article-date {
      font-size: 0.72rem;
      color: #9ca3af;
    }

    /* ARTICLE PAGE */
    .article-container {
      max-width: 780px;
      margin: 0 auto;
      width: 100%;
      padding: 2.5rem 5% 5rem;
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.78rem;
      color: #9ca3af;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--violet); }
    .breadcrumb span { color: #d1d5db; }
    .article-header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 2px solid var(--border); }
    .article-header h1 {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3.5vw, 2.2rem);
      font-weight: 800;
      color: var(--dark);
      line-height: 1.2;
      letter-spacing: -0.025em;
      margin: 0.5rem 0 0.75rem;
    }
    .article-meta { font-size: 0.8rem; color: #9ca3af; }

    /* ARTICLE CONTENT */
    .content h2 {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--dark);
      margin: 2.5rem 0 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--violet-pale);
    }
    .content h3 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--dark);
      margin: 2rem 0 0.5rem;
    }
    .content p { color: #374151; font-size: 0.97rem; margin-bottom: 1.25rem; line-height: 1.8; }
    .content ul, .content ol { margin: 0 0 1.25rem 1.5rem; }
    .content li { color: #374151; font-size: 0.97rem; margin-bottom: 0.4rem; line-height: 1.7; }
    .content strong { color: var(--dark); font-weight: 600; }
    .content a { color: var(--violet); font-weight: 500; text-decoration: underline; text-underline-offset: 2px; }
    .content a:hover { color: var(--violet-dark); }
    .content blockquote {
      border-left: 4px solid var(--violet);
      background: var(--violet-pale);
      border-radius: 0 8px 8px 0;
      padding: 1rem 1.5rem;
      margin: 1.75rem 0;
      font-style: italic;
      color: #4b5563;
    }
    .content hr { border: none; border-top: 2px solid var(--border); margin: 2rem 0; }
    .content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.875rem; border-radius: 8px; overflow: hidden; }
    .content th { background: var(--violet); color: white; font-family: var(--font-display); font-weight: 700; padding: 0.7rem 1rem; text-align: left; }
    .content td { padding: 0.65rem 1rem; border-bottom: 1px solid var(--border); color: #374151; }
    .content tr:last-child td { border-bottom: none; }
    .content tr:nth-child(even) td { background: #f9fafb; }

    /* CTA BOX */
    .cta-box {
      background: linear-gradient(135deg, var(--violet-dark) 0%, var(--violet) 100%);
      border-radius: 16px;
      padding: 2.5rem 2rem;
      text-align: center;
      margin-top: 3rem;
    }
    .cta-box h3 { font-family: var(--font-display); font-size: 1.3rem; font-weight: 800; color: white; margin-bottom: 0.6rem; }
    .cta-box p { color: rgba(255,255,255,.7); font-size: 0.95rem; margin-bottom: 1.5rem; }
    .cta-box a {
      display: inline-block;
      background: var(--yellow);
      color: var(--dark) !important;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.8rem 2rem;
      border-radius: 8px;
      text-decoration: none !important;
      transition: background .15s, transform .1s;
    }
    .cta-box a:hover { background: var(--yellow-dark); transform: translateY(-1px); }

    /* FAQ */
    .faq-section { margin-top: 3rem; border-top: 2px solid var(--border); padding-top: 2rem; }
    .faq-section h2 { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; margin-bottom: 1.5rem; }
    .faq-item { margin-bottom: 1.25rem; background: var(--white); border: 1.5px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem; }
    .faq-item h3 { font-family: var(--font-display); font-size: 0.97rem; font-weight: 700; margin-bottom: 0.4rem; }
    .faq-item p { font-size: 0.9rem; color: var(--gray); margin: 0; }

    /* FOOTER */
    .site-footer {
      background: #1f1535;
      color: rgba(255,255,255,.4);
      padding: 2rem 5%;
      text-align: center;
      font-size: 0.78rem;
      line-height: 2;
    }
    .site-footer a { color: rgba(255,255,255,.5); }
    .site-footer a:hover { color: var(--yellow); text-decoration: none; }

    @media (max-width: 640px) {
      .hero { padding: 3rem 4% 2.5rem; }
      .home-container { padding: 2rem 4% 4rem; }
      .article-container { padding: 2rem 4% 4rem; }
      .articles-grid { grid-template-columns: 1fr; }
      .header-nav > a:not(.btn-cta) { display: none; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-left">
      <a href={i18n.blogLink} class="logo" aria-label={i18n.blogLabel}>
        <img src={logoUrl} alt="Grow Lot" />
      </a>
      <a href={i18n.altLangHref} class="lang-pill">{i18n.altLangLabel}</a>
    </div>
    <nav class="header-nav">
      <a href={i18n.blogLink}>{isEN ? "Home" : "Accueil"}</a>
      <a href={signupUrl} target="_blank" class="btn-cta">{i18n.ctaLabel}</a>
    </nav>
  </header>

  <div class="page-body">
    <slot />
  </div>

  <footer class="site-footer">
    <p>© {new Date().getFullYear()} <a href={siteUrl} target="_blank">Grow Lot</a> — {i18n.footerTagline}</p>
    <p>{i18n.footerDisclaimer}</p>
  </footer>
</body>
</html>
