---
const { title, description, date, category, author, lang = 'fr' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isEn = lang === 'en';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Blog Grow Lot</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content={author || 'Grow Lot'} />
  <meta name="ai-content-declaration" content="human-written" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  {isEn
    ? <link rel="alternate" hreflang="fr" href={`https://blog.grow-lot.com${Astro.url.pathname.replace('/en', '')}`} />
    : <link rel="alternate" hreflang="en" href={`https://blog.grow-lot.com/en${Astro.url.pathname}`} />
  }
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@700;800&display=swap" rel="stylesheet" />
  {date && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": date,
      "inLanguage": lang,
      "author": { "@type": "Organization", "name": "Grow Lot", "url": "https://grow-lot.com" },
      "publisher": { "@type": "Organization", "name": "Grow Lot", "url": "https://grow-lot.com" }
    })} />
  )}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --purple: #7c3aed;
      --purple-dark: #6d28d9;
      --purple-light: #f0eeff;
      --purple-pale: #faf8ff;
      --dark: #0f172a;
      --gray: #64748b;
      --border: #e8e4f9;
      --white: #ffffff;
      --radius: 12px;
      --shadow: 0 4px 20px rgba(124,58,237,0.08);
      --max-w: 760px;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--white);
      color: var(--dark);
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    a { color: var(--purple); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── HEADER ── */
    .site-header {
      border-bottom: 1px solid var(--border);
      padding: 0 5%;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      background: var(--white);
      z-index: 100;
      box-shadow: 0 1px 4px rgba(124,58,237,0.06);
    }
    .logo {
      font-family: 'Poppins', sans-serif;
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--purple);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .logo span { color: var(--dark); }
    .header-nav { display: flex; align-items: center; gap: 0.5rem; }
    .header-nav a {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--gray);
      padding: 0.35rem 0.75rem;
      border-radius: 8px;
      transition: color .15s, background .15s;
    }
    .header-nav a:hover { color: var(--purple); background: var(--purple-light); text-decoration: none; }
    .lang-btn {
      font-size: 0.78rem !important;
      font-weight: 700 !important;
      border: 1.5px solid var(--border) !important;
      color: var(--gray) !important;
    }
    .lang-btn:hover { border-color: var(--purple) !important; color: var(--purple) !important; }
    .cta-btn-header {
      background: var(--purple) !important;
      color: var(--white) !important;
      font-weight: 700 !important;
      font-size: 0.85rem !important;
      padding: 0.4rem 1.1rem !important;
    }
    .cta-btn-header:hover { background: var(--purple-dark) !important; }

    /* ── HERO ── */
    .hero {
      background: linear-gradient(135deg, #1e0a3c 0%, #2d1060 100%);
      padding: 4.5rem 5% 3.5rem;
      text-align: center;
    }
    .hero-eyebrow {
      display: inline-block;
      background: rgba(124,58,237,.25);
      color: #c4b5fd;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: .07em;
      padding: 0.3rem 0.9rem;
      border-radius: 20px;
      border: 1px solid rgba(196,181,253,.2);
      margin-bottom: 1.1rem;
      font-family: 'Poppins', sans-serif;
      text-transform: uppercase;
    }
    .hero h1 {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      font-weight: 800;
      color: var(--white);
      margin-bottom: 0.9rem;
      letter-spacing: -0.03em;
      line-height: 1.2;
    }
    .hero h1 em {
      font-style: normal;
      background: linear-gradient(90deg, #c4b5fd, #7c3aed);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero p {
      color: rgba(255,255,255,.6);
      font-size: 1rem;
      max-width: 460px;
      margin: 0 auto;
    }

    /* ── MAIN ── */
    main {
      flex: 1;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 3rem 5% 5rem;
      width: 100%;
    }

    /* ── POST CARDS ── */
    .section-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .section-header h2 {
      font-family: 'Poppins', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: var(--dark);
      white-space: nowrap;
    }
    .section-line { flex: 1; height: 1px; background: var(--border); }
    .section-count { font-size: 0.75rem; color: var(--gray); }

    .articles-grid { display: grid; gap: 1rem; }

    .article-card {
      display: block;
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem 1.75rem;
      color: inherit !important;
      text-decoration: none !important;
      transition: border-color .2s, box-shadow .2s, transform .2s;
    }
    .article-card:hover {
      border-color: var(--purple);
      box-shadow: var(--shadow);
      transform: translateY(-2px);
    }
    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }
    .category-badge {
      display: inline-block;
      background: var(--purple-light);
      color: var(--purple);
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.65rem;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: .06em;
      font-family: 'Poppins', sans-serif;
    }
    .article-card h2 {
      font-family: 'Poppins', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--dark);
      margin-bottom: 0.4rem;
      line-height: 1.3;
    }
    .article-card p { color: var(--gray); font-size: 0.875rem; margin-bottom: 1rem; }
    .card-footer { display: flex; align-items: center; justify-content: space-between; }
    .read-more { font-size: 0.82rem; font-weight: 700; color: var(--purple); font-family: 'Poppins', sans-serif; }
    .article-date { font-size: 0.74rem; color: #94a3b8; }

    /* ── ARTICLE ── */
    .article-header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1.5px solid var(--border); }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.78rem;
      color: #94a3b8;
      margin-bottom: 1.1rem;
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--purple); }
    .breadcrumb-sep { color: #cbd5e1; }

    .article-header h1 {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      margin: 0.6rem 0 0.75rem;
      line-height: 1.2;
    }
    .article-meta { font-size: 0.8rem; color: #94a3b8; margin-top: 0.25rem; }

    /* ── CONTENT ── */
    .content h2 {
      font-family: 'Poppins', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      margin: 2.75rem 0 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--purple-light);
      color: var(--dark);
    }
    .content h3 { font-family: 'Poppins', sans-serif; font-size: 1.05rem; font-weight: 700; margin: 1.75rem 0 0.5rem; color: var(--dark); }
    .content p { margin-bottom: 1.2rem; color: #334155; }
    .content ul, .content ol { margin: 0.25rem 0 1.2rem 1.4rem; }
    .content li { margin-bottom: 0.4rem; color: #334155; }
    .content strong { color: var(--dark); font-weight: 600; }
    .content a { color: var(--purple); font-weight: 500; text-decoration: underline; text-underline-offset: 2px; }
    .content a:hover { color: var(--purple-dark); }
    .content blockquote {
      border-left: 4px solid var(--purple);
      background: var(--purple-pale);
      border-radius: 0 8px 8px 0;
      padding: 1rem 1.4rem;
      margin: 1.75rem 0;
      font-style: italic;
      color: #475569;
    }
    .content blockquote p { margin: 0; color: #475569; }
    .content hr { border: none; border-top: 1.5px solid var(--border); margin: 2rem 0; }

    /* ── CTA BOX ── */
    .cta-box {
      background: linear-gradient(135deg, #1e0a3c 0%, #2d1060 100%);
      border-radius: 16px;
      padding: 2.5rem 2rem;
      text-align: center;
      margin: 3.5rem 0 0;
    }
    .cta-box h3 { font-family: 'Poppins', sans-serif; font-size: 1.3rem; color: white; margin-bottom: 0.6rem; }
    .cta-box p { color: rgba(255,255,255,.65); font-size: 0.95rem; margin-bottom: 1.5rem; }
    .cta-box a {
      display: inline-block;
      background: var(--purple);
      color: white !important;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.8rem 2rem;
      border-radius: 8px;
      text-decoration: none !important;
      transition: background .15s, transform .1s;
    }
    .cta-box a:hover { background: var(--purple-dark); transform: translateY(-1px); }

    /* ── FOOTER ── */
    .site-footer {
      background: #0f0a1e;
      color: rgba(255,255,255,.35);
      padding: 1.5rem 5%;
      text-align: center;
      font-size: 0.78rem;
      line-height: 1.8;
    }
    .site-footer a { color: rgba(255,255,255,.5); }
    .site-footer a:hover { color: #c4b5fd; text-decoration: underline; }

    @media (max-width: 600px) {
      .hero { padding: 3rem 4% 2.5rem; }
      main { padding: 2rem 4% 4rem; }
      .article-card { padding: 1.25rem; }
      .header-nav a:not(.cta-btn-header):not(.lang-btn) { display: none; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a href={isEn ? '/en' : '/'} class="logo">🌱 <span>Blog Grow Lot</span></a>
    <nav class="header-nav">
      <a href={isEn ? '/en' : '/'}>{isEn ? 'Home' : 'Accueil'}</a>
      <a href={isEn ? '/' : '/en'} class="lang-btn">{isEn ? '🇫🇷 FR' : '🇬🇧 EN'}</a>
      <a href="https://app.grow-lot.com?utm_source=growlot-blog&utm_medium=blog&utm_campaign=header" target="_blank" class="cta-btn-header">{isEn ? 'Try Grow Lot' : 'Essayer Grow Lot'}</a>
    </nav>
  </header>

  <div style="flex:1;display:flex;flex-direction:column;">
    <slot />
  </div>

  <footer class="site-footer">
    <p>© {new Date().getFullYear()} <a href="https://app.grow-lot.com">Grow Lot</a> — {isEn ? 'Blog for merchants who retain better.' : 'Blog des commerçants qui fidélisent mieux.'}</p>
    <p>{isEn ? 'Some links are affiliate links.' : 'Certains liens peuvent être affiliés.'}</p>
  </footer>
</body>
</html>
