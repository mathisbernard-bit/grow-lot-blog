---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const today = new Date();
today.setHours(23, 59, 59, 999);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => (post.data.lang ?? 'fr') === 'en' && new Date(post.data.date) <= today)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<Base title="Grow Lot Blog — Loyalty guides for merchants" description="Practical guides, tips and strategies to boost your customer loyalty and Google reviews." lang="en">
  <div class="hero">
    <h1>The blog for merchants who retain better 🌱</h1>
    <p>Practical guides, advice and strategies to boost your customer loyalty and Google reviews.</p>
  </div>

  <div class="articles-grid">
    {posts.map(post => (
      <a href={`/en/blog/${post.slug.replace('en/', '')}`} class="article-card" style="text-decoration:none;color:inherit;">
        <span class="category-badge">{post.data.category}</span>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <span class="read-more">Read article →</span>
        <p class="article-date">{new Date(post.data.date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
      </a>
    ))}
  </div>
</Base>
