---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const today = new Date();
  today.setHours(23, 59, 59, 999);
  const posts = await getCollection('blog');
  return posts
    .filter(p => p.data.lang === 'en' && new Date(p.data.date) <= today)
    .map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<Base
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  category={post.data.category}
  author={post.data.author}
  lang="en"
>
  <main>
    <article>
      <header class="article-header">
        <nav class="breadcrumb">
          <a href="/en">Home</a>
          <span class="breadcrumb-sep">›</span>
          <span>{post.data.title}</span>
        </nav>
        <span class="category-badge">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p class="article-meta">
          By {post.data.author} · {new Date(post.data.date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      </header>
      <div class="content">
        <Content />
      </div>
      <div class="cta-box">
        <h3>Ready to try Grow Lot?</h3>
        <p>Spin-the-wheel, negative review filter, marketing automation — from €49/month for life.</p>
        <a href="https://app.grow-lot.com?utm_source=growlot-blog&utm_medium=blog&utm_campaign=article-cta-en" target="_blank">Try Grow Lot →</a>
      </div>
    </article>
  </main>
</Base>
